226,1231,1234,1238,1245,1260,1263,1266,1269,1272,1279,1289,1292,1300,1303,1306,1309,1312,1328],[978,979,966],"h2",{"id":980},"ubuntu装进移动硬盘",[978,982,983],{"id":983},"安装流程",[985,986,987],"h3",{"id":987},"写在前面",[989,990,991],"blockquote",{},[992,993,994],"p",{},"本文记录本人使用移动硬盘安装Ubuntu系统的全过程，实现一个硬盘随插随用，任意电脑都可以使用（windows机器），但过程中也有踩坑，也不保证完全按照流程下来不会出错，仅供参考，下面罗列我的参考文章",[992,996,997],{},[998,999,1003],"a",{"href":1000,"rel":1001},"https:\u002F\u002Fzhuanlan.zhihu.com\u002Fp\u002F618018275?s_r=0",[1002],"nofollow","(72 封私信 \u002F 80 条消息) Ubuntu系统安装在移动固态硬盘，实现在不同电脑即插即用 - 知乎",[992,1005,1006],{},[998,1007,1010],{"href":1008,"rel":1009},"https:\u002F\u002Fblog.csdn.net\u002Fqq_42699580\u002Farticle\u002Fdetails\u002F104312383",[1002],"Windows系统下，Ubuntu安装至移动硬盘（简单分析与详细安装教程）_移动硬盘安装ubuntu-CSDN博客",[992,1012,1013],{},[998,1014,1017],{"href":1015,"rel":1016},"https:\u002F\u002Fblog.csdn.net\u002Fweixin_42776111\u002Farticle\u002Fdetails\u002F84961031",[1002],"新手安装 Ubuntu 操作系统步骤教程_ubuntu安装教程-CSDN博客",[992,1019,1020],{},[998,1021,1024],{"href":1022,"rel":1023},"https:\u002F\u002Fwww.bilibili.com\u002Fvideo\u002FBV1CG4y1h7bx\u002F?spm_id_from=333.337.search-card.all.click",[1002],"Ubuntu安装详细教程_哔哩哔哩_bilibili",[985,1026,1028],{"id":1027},"ubuntu-系统镜像下载","Ubuntu 系统镜像下载",[992,1030,1031],{},"选择的是清华镜像源",[992,1033,1034],{},[998,1035,1038],{"href":1036,"rel":1037},"https:\u002F\u002Fmirrors.tuna.tsinghua.edu.cn\u002Fubuntu-releases\u002F22.04\u002F",[1002],"Index of \u002Fubuntu-releases\u002F22.04\u002F | 清华大学开源软件镜像站 | Tsinghua Open Source Mirror",[992,1040,1041],{},"版本选择",[992,1043,1044],{},[1045,1046],"img",{"alt":1047,"src":1048},"image-20250825121711349","https:\u002F\u002Fphenthu-1321233386.cos.ap-nanjing.myqcloud.com\u002Fimg\u002Fimage-20250825121711349.png",[985,1050,1052],{"id":1051},"u盘启动盘制作","U盘启动盘制作",[992,1054,1055],{},"插入U盘，打开UltraISO软件，不需要注册、不需要订购，点击“继续试用”即可",[992,1057,1058],{},[1045,1059],{"alt":1060,"src":1061},"image-20250825121725885","https:\u002F\u002Fphenthu-1321233386.cos.ap-nanjing.myqcloud.com\u002Fimg\u002Fimage-20250825121725885.png",[992,1063,1064],{},"在软件界面找到Ubuntu 的iso文件",[1045,1066],{"src":1067,"alt":1068,"style":1069},"https:\u002F\u002Fphenthu-1321233386.cos.ap-nanjing.myqcloud.com\u002Fimg\u002Fimage-20250825121745458.png","image-20250825121745458","zoom:50%;",[992,1071,1072,1073],{},"在菜里栏中 ",[1074,1075,1076],"strong",{},"启动一>写入硬盘映像",[1045,1078],{"src":1079,"alt":1080,"style":1081},"https:\u002F\u002Fphenthu-1321233386.cos.ap-nanjing.myqcloud.com\u002Fimg\u002Fimage-20250825121801134.png","image-20250825121801134","zoom: 67%;",[992,1083,1084],{},"格式化之后进行写入，写入成功的界面如下：",[1045,1086],{"src":1087,"alt":1045,"style":1088},"https:\u002F\u002Fphenthu-1321233386.cos.ap-nanjing.myqcloud.com\u002Fimg\u002Fasynccode","zoom: 33%;",[985,1090,1091],{"id":1091},"移动硬盘分区",[992,1093,1094,1095,1098],{},"打开DiskGenius软件，在其左侧导航栏中点击选中需要分区的移动硬盘，在",[1074,1096,1097],{},"基本GPT","处右键，点击创建新分区",[989,1100,1101],{},[992,1102,1103],{},"如果你这里不是基本GPT 是基本MBR 那么你需要点击磁盘盘符 （我这里是HD1:Sandiskextreme55AE）,右键，选择“转换分区表类型为GUID格式”",[1045,1105],{"src":1106,"alt":1107,"style":1108},"https:\u002F\u002Fphenthu-1321233386.cos.ap-nanjing.myqcloud.com\u002Fimg\u002Fimage-20250825121953328.png","image-20250825121953328","zoom:40%;",[992,1110,1111,1112],{},"建立新分区的详细操作可以参考下面这个文章，但是",[1074,1113,1114],{},"注意不要学习他的分区命名",[992,1116,1117],{},[998,1118,1010],{"href":1008,"rel":1119},[1002],[992,1121,1122],{},"我们一共分四个区域：",[1124,1125,1126,1139,1149,1159],"ol",{},[1127,1128,1129,1132,1133],"li",{},[1074,1130,1131],{},"ESP(0)分区"," ：文件系统类型为FAT32，大小我分配为1.0GB。该分区用于Linux系统的 \u002Fboot引导分区，后续启动 Ubuntu 系统的引导文件将会放在这个分区下的EFI目录，所以这个分区很重要\n",[1134,1135,1136],"ul",{},[1127,1137,1138],{},"注意这个分区的建立请直接在右键之后的“建立ESP\u002FMSR分区”这里建立ESP分区就好了，我这里建立的是1024MB（软件显示1G）大小",[1127,1140,1141,1144,1145,1148],{},[1074,1142,1143],{},"分区(1)","：文件系统类型为Linux swap partition，大小我分配为16.0GB。该分区用于Linux系统的",[1074,1146,1147],{},"swap","交换空间",[1127,1150,1151,1154,1155,1158],{},[1074,1152,1153],{},"分区(2)","：文件系统类型为EXT4，大小我分配为80GB。该分区用于Linux系统的 ",[1074,1156,1157],{},"“\u002F”"," 目录。",[1127,1160,1161,1164,1165,1158],{},[1074,1162,1163],{},"分区(3)"," ：文件系统类型为EXT4大小我分配为200 GB。该分区用于Linux系统的 ",[1074,1166,1167],{},"\"\u002Fhome\"",[992,1169,1170],{},"注意，这四个分区对于EXT4类型文件系统是可以按照下面方法设置的（这个图来自上面的csdn），其他分区最好先不要设置卷标，也可以都不设置卷标",[1045,1172],{"src":1173,"alt":1174,"style":1088},"https:\u002F\u002Fphenthu-1321233386.cos.ap-nanjing.myqcloud.com\u002Fimg\u002Fimage-20250825161745305.png","image-20250825161745305",[992,1176,1177],{},"四个分区建立后，点击上方图标栏的“保存更改”按钮，完成分区。",[985,1179,1181],{"id":1180},"安装ubuntu系统","安装Ubuntu系统",[989,1183,1184],{},[992,1185,1186,1187],{},"在Ubuntu系统安装之前，",[1074,1188,1189],{},"需要记住自己的移动硬盘容量大小及其命名、电脑硬盘大小以及自定义的Ubuntu系统4个分区的大小",[992,1191,1192,1193,1196,1197,1201],{},"接下来就是对Ubunut系统的安装了，重启电脑，在开机界面",[1074,1194,1195],{},"按住F2进入BIOS界面","（不同电脑可能不一样，自行善用搜索即可），在BIOS界面找到 Secure Boot(或安全启动)，将其关闭，而后找到Boot Option(或启动选项)，将USB启动项设置为第一启动，然后保存并退出BIOS界面，这个时候就会从U盘进行启动Ubuntu安装界面（原谅我只找到了这个高糊画质，参考",[998,1198,1024],{"href":1199,"rel":1200},"https:\u002F\u002Fwww.bilibili.com\u002Fvideo\u002FBV1CG4y1h7bx\u002F?spm_id_from=333.337.search-card.all.click&vd_source=a18b4e2a531bfb64d1c42547f9fe1ad7",[1002],"）",[1045,1203],{"src":1204,"alt":1205,"style":1206},"https:\u002F\u002Fphenthu-1321233386.cos.ap-nanjing.myqcloud.com\u002Fimg\u002Fimage-20250825184058316.png","image-20250825184058316","zoom:33%;",[992,1208,1209,1210,1214,1215,1218],{},"我点击了第一个",[1211,1212,1213],"code",{"code":1213},"Try or Install Ubuntu"," 但是点击之后就是黑屏，有一个光标，但是按键盘没任何反应；所以我选了第二个",[1211,1216,1217],{"code":1217},"Ubuntu(safe graphics)","才成功进入启动界面，神奇。",[992,1220,1221],{},"进入安装界面之后，首先是一些常规选项，参考上面B站视频或者是csdn链接都可以，一路设置之后，到了这里",[1045,1223],{"src":1224,"alt":1225,"style":1069},"https:\u002F\u002Fphenthu-1321233386.cos.ap-nanjing.myqcloud.com\u002Fimg\u002Fimage-20250825185136885.png","image-20250825185136885",[992,1227,1228],{},[1074,1229,1230],{},"这里要注意一定要选择其他选项，不然你电脑原本的windows硬盘有可能也被格式化了！！！",[992,1232,1233],{},"继续之后会是下面的界面",[1045,1235],{"src":1236,"alt":1237,"style":1069},"https:\u002F\u002Fphenthu-1321233386.cos.ap-nanjing.myqcloud.com\u002Fimg\u002Fimage-20250825185349917.png","image-20250825185349917",[992,1239,1240,1241,1244],{},"你的这个界面可能会有很多选项，但是请你仔细识别，这里面包含了windows分区的磁盘和你插入的移动硬盘的分区，一般来说你首先看有一个Windows Boot Manager ，那么这个盘就是Windows的硬盘，同一个名字下面的都不要动，那显然还有另外一个设备，那么你可以根据内存大致推断他是不是你的硬盘，然后按照分区来，",[1074,1242,1243],{},"\"安装启动引导器的设备\"一定要选择 \u002Fboot 对应的分区---ESP分区","，然后可能上面这个图也不是很准确，你的界面的挂载点应该是空的，没有任何选项，然后只有两个ext4类型的分区设备，分别双击他们进行更改，你发现可以更改他们的挂载点，对应我前面提到的：",[1124,1246,1247,1253],{},[1127,1248,1249,1154,1251,1158],{},[1074,1250,1153],{},[1074,1252,1157],{},[1127,1254,1255,1257,1258,1158],{},[1074,1256,1163],{}," ：文件系统类型为EXT4，大小我分配为200 GB。该分区用于Linux系统的 ",[1074,1259,1167],{},[992,1261,1262],{},"这两部分更改好了之后就选好启动盘(\"安装启动引导器的设备\"选择 \u002Fboot 对应的分区---ESP分区)，直接安装就行了。",[992,1264,1265],{},"然后系统会提示你进行重启，注意重启的时候要拔掉启动U盘，我在这一步进入了grub界面，这是因为系统找不到ubuntu的启动文件了，这个时候可以参考网上资料找一找，但是我当时只是输入exit，然后启动的时候把启动引导选择了windows，进了一次windows之后再次返回启动Ububtu界面，发现就好了，正常进入系统。神奇。。。。",[992,1267,1268],{},"到这个阶段为止，Ubuntu在你的电脑上就可以顺畅使用了，但是在别人电脑上还不行。",[992,1270,1271],{},"当把移动固态硬盘插到其他电脑时，是不能正常使用的，原因是移动硬盘的ESP分区中没有引导文件，解决过程如下：",[992,1273,1274,1275,1278],{},"重新插上U盘和移动固态硬盘，进入Ubuntu系统后，连上网络，安装 ",[1074,1276,1277],{},"boot-repair"," 软件：",[1280,1281,1287],"pre",{"className":1282,"code":1284,"language":1285,"meta":1286},[1283],"language-powershell","sudo apt-add-repository ppa:yannubuntu\u002Fboot-repair\nsudo apt update\nsudo apt install boot-repair\n","powershell","",[1211,1288,1284],{"__ignoreMap":1286},[992,1290,1291],{},"安装完成后，打开终端执行该软件",[1280,1293,1298],{"className":1294,"code":1296,"language":1297,"meta":1286},[1295],"language-bash","boot-repair\n","bash",[1211,1299,1296],{"__ignoreMap":1286},[992,1301,1302],{},"点击**Recommended repair（或推荐修复）**按钮，等待修复完成即可",[992,1304,1305],{},"之后就可以随便任意电脑都可以打开你的移动硬盘上的Ubuntu系统啦！",[978,1307,1308],{"id":1308},"后续调整",[992,1310,1311],{},"对于磁盘大小调整,参考",[1124,1313,1314,1321],{},[1127,1315,1316],{},[998,1317,1320],{"href":1318,"rel":1319},"https:\u002F\u002Fcn.linux-terminal.com\u002F?p=7992#:~:text=%E4%BD%BF%E7%94%A8%E7%B3%BB%E7%BB%9F%E5%86%85%E7%BD%AE%E7%9A%84%E2%80%9C%E7%A3%81%E7%9B%98%E2%80%9D%E5%B7%A5%E5%85%B7%E5%8F%AF%E4%BB%A5%E5%BE%88%E5%AE%B9%E6%98%93%E5%9C%B0%E7%BC%A9%E5%B0%8F%E5%88%86%E5%8C%BA%E4%BB%A5%E5%87%8F%E5%B0%8F%E5%85%B6%E5%A4%A7%E5%B0%8F%E3%80%82%20%E9%A6%96%E5%85%88%EF%BC%8C%E6%90%9C%E7%B4%A2%E5%B9%B6%E5%90%AF%E5%8A%A8%E2%80%9C%20%E7%A3%81%E7%9B%98%20%E2%80%9D%E5%B7%A5%E5%85%B7%E3%80%82%20%E8%AF%A5%E5%B7%A5%E5%85%B7%E6%89%93%E5%BC%80%E5%90%8E%EF%BC%8C%E9%80%89%E6%8B%A9%E5%B7%A6%E4%BE%A7%E7%9A%84%E7%A3%81%E7%9B%98%E9%A9%B1%E5%8A%A8%E5%99%A8%EF%BC%8C%E7%84%B6%E5%90%8E%E9%80%89%E6%8B%A9%E8%A6%81%E7%BC%A9%E5%B0%8F%E7%9A%84%E5%88%86%E5%8C%BA%E3%80%82%20%E6%9C%80%E5%90%8E%EF%BC%8C%E5%8D%95%E5%87%BB%E4%B8%8B%E9%9D%A2%E7%9A%84%E9%BD%BF%E8%BD%AE%E5%9B%BE%E6%A0%87%E4%BB%A5%E8%8E%B7%E5%8F%96%E2%80%9C,%E8%B0%83%E6%95%B4%E5%A4%A7%E5%B0%8F...%E2%80%9D%20%E6%B3%A8%E6%84%8F%EF%BC%9A%E5%B9%B6%E9%9D%9E%E6%89%80%E6%9C%89%E6%96%87%E4%BB%B6%E7%B3%BB%E7%BB%9F%E9%83%BD%E5%8F%AF%E4%BB%A5%E8%B0%83%E6%95%B4%E5%A4%A7%E5%B0%8F%E3%80%82%20%E5%9C%A8%E6%88%91%E7%9A%84%E6%B5%8B%E8%AF%95%E4%B8%AD%EF%BC%8C%E5%AE%83%E8%83%BD%E5%A4%9F%E8%B0%83%E6%95%B4%2F%E7%BC%A9%E5%B0%8F%20Ext4%E3%80%81NTFS%20%E5%88%86%E5%8C%BA%E7%9A%84%E5%A4%A7%E5%B0%8F%E3%80%82%20%E5%9C%A8%E4%B8%8B%E4%B8%80%E4%B8%AA%E5%AF%B9%E8%AF%9D%E6%A1%86%E4%B8%AD%EF%BC%8C%E6%82%A8%E7%8E%B0%E5%9C%A8%E5%8F%AF%E4%BB%A5%E7%A7%BB%E5%8A%A8%E6%BB%91%E5%9D%97%E6%9D%A5%E8%AE%BE%E7%BD%AE%E7%BC%A9%E5%B0%8F%E7%9A%84%E7%A9%BA%E9%97%B4%E9%87%8F%E3%80%82",[1002],"如何在 Ubuntu 24.04 中缩小、移动或扩展系统分区",[1127,1322,1323],{},[998,1324,1327],{"href":1325,"rel":1326},"https:\u002F\u002Fblog.csdn.net\u002Fm0_48160420\u002Farticle\u002Fdetails\u002F146489694",[1002],"Ubuntu 24.04 LTS磁盘空间不足解决",[992,1329,1330],{},"以及在gparted里面最好不要动exfat 这种非linux file 格式的磁盘空间，很容易卡住。。。 当时动了我的本来作为U盘的分区 还好只是分区表之类的损坏了 吓死个人",{"title":1286,"searchDepth":1332,"depth":1332,"links":1333},4,[1334,1336,1344],{"id":980,"depth":1335,"text":966},2,{"id":983,"depth":1335,"text":983,"children":1337},[1338,1340,1341,1342,1343],{"id":987,"depth":1339,"text":987},3,{"id":1027,"depth":1339,"text":1028},{"id":1051,"depth":1339,"text":1052},{"id":1091,"depth":1339,"text":1091},{"id":1180,"depth":1339,"text":1181},{"id":1308,"depth":1335,"text":1308},[1346],"Ubuntu","此系列主要是 lz 折腾 ubuntu 系统安装、迁移以及 IC Design 软件在 Ubuntu 上的安装","md","\u002Fimg\u002FUbuntu.png",{"slots":1351},{},null,{"text":269,"minutes":969,"time":970,"words":971},{"title":966,"description":1347},{"loc":965,"images":1356},[1357,1358,1359,1360,1361,1362,1363,1364,1365,1366],{"loc":1048},{"loc":1061},{"loc":1067},{"loc":1079},{"loc":1087},{"loc":1106},{"loc":1173},{"loc":1204},{"loc":1224},{"loc":1236},[1368,1369],"Install","操作系统安装","tech","gJoPnFy-PoZLePBLRU4Hn91nMVn9NMiFQ8Deb1xdNkk",[1373,1374],{"title":38,"path":37,"stem":36,"date":39,"type":1370,"children":-1},{"title":908,"path":907,"stem":906,"date":909,"type":1370,"children":-1},1789097767417]