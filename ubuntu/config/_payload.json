id":1060},"字体安装",[1019,1062,1065],{"className":1063,"code":1064,"language":1024,"meta":1025},[1022],"# linux version\nsudo apt update\nsudo apt install fonts-cascadia-code\n",[1027,1066,1064],{"__ignoreMap":1025},[1039,1068,1070],{"id":1069},"powerlevel10k-重新运行配置向导","Powerlevel10k 重新运行配置向导",[1019,1072,1075],{"className":1073,"code":1074,"language":1024,"meta":1025},[1022],"p10k configure\n",[1027,1076,1074],{"__ignoreMap":1025},[1039,1078,1080],{"id":1079},"starship命令提示-git-符号显示","Starship：命令提示 + Git 符号显示",[1019,1082,1085],{"className":1083,"code":1084,"language":1024,"meta":1025},[1022],"# 使用 gnu 版本而不是 musl 版本\nsudo wget -O \u002Ftmp\u002Fstarship.tar.gz https:\u002F\u002Fgithub.com\u002Fstarship\u002Fstarship\u002Freleases\u002Flatest\u002Fdownload\u002Fstarship-x86_64-unknown-linux-gnu.tar.gz\n\n# 解压\ncd \u002Ftmp\nsudo tar -xzf starship.tar.gz\n\n# 移动到系统路径\nsudo mv starship \u002Fusr\u002Flocal\u002Fbin\u002F\n\n# 设置执行权限\nsudo chmod +x \u002Fusr\u002Flocal\u002Fbin\u002Fstarship\n\n# 清理\nsudo rm starship.tar.gz\n\n# 验证安装\nstarship --version\n\necho 'eval \"$(starship init zsh)\"' >> ~\u002F.zshrc\nsource ~\u002F.zshrc\n",[1027,1086,1084],{"__ignoreMap":1025},[1039,1088,1041],{"id":1089},"参考资料-1",[1043,1091,1092,1099],{},[1046,1093,1094],{},[1049,1095,1098],{"href":1096,"rel":1097},"https:\u002F\u002Fsorrycc.com\u002Fmac",[1053],"sorrycc 的 Mac 配置",[1046,1100,1101],{},[1049,1102,1105],{"href":1103,"rel":1104},"https:\u002F\u002Fwww.haoyep.com\u002Fposts\u002Fzsh-config-oh-my-zsh\u002F",[1053],"zsh 安装与配置，使用 oh-my-zsh 美化终端",[1011,1107,1109],{"id":1108},"ubuntuwindows-双启动时间冲突","Ubuntu\u002FWindows 双启动时间冲突",[1039,1111,1112],{"id":1112},"问题原因",[1043,1114,1115,1122,1128],{},[1046,1116,1117,1121],{},[1118,1119,1120],"strong",{},"Windows","：硬件时钟存储本地时间",[1046,1123,1124,1127],{},[1118,1125,1126],{},"Ubuntu","：硬件时钟存储 UTC 时间",[1046,1129,1130,1133],{},[1118,1131,1132],{},"结果","：切换系统时出现 8 小时时差",[1039,1135,1137],{"id":1136},"ubuntu-2204-及以下解决方案","Ubuntu 22.04 及以下解决方案",[1139,1140,1141,1150,1159,1168],"ol",{},[1046,1142,1143,1144],{},"安装时间同步工具",[1019,1145,1148],{"className":1146,"code":1147,"language":1024,"meta":1025},[1022],"sudo apt install ntpdate\n",[1027,1149,1147],{"__ignoreMap":1025},[1046,1151,1152,1153],{},"同步时间",[1019,1154,1157],{"className":1155,"code":1156,"language":1024,"meta":1025},[1022],"sudo ntpdate time.windows.com\n",[1027,1158,1156],{"__ignoreMap":1025},[1046,1160,1161,1162],{},"设置硬件时钟为本地时间",[1019,1163,1166],{"className":1164,"code":1165,"language":1024,"meta":1025},[1022],"sudo hwclock --localtime --systohc\n",[1027,1167,1165],{"__ignoreMap":1025},[1046,1169,1170,1171],{},"配置系统使用本地时区 RTC",[1019,1172,1175],{"className":1173,"code":1174,"language":1024,"meta":1025},[1022],"sudo timedatectl set-local-rtc 1 --adjust-system-clock\n",[1027,1176,1174],{"__ignoreMap":1025},[1039,1178,1179],{"id":1179},"验证结果",[1019,1181,1184],{"className":1182,"code":1183,"language":1024,"meta":1025},[1022],"timedatectl status\n",[1027,1185,1183],{"__ignoreMap":1025},[1015,1187,1188,1189],{},"确认显示：",[1027,1190,1191],{"code":1191},"RTC in local TZ: yes",[1039,1193,1194],{"id":1194},"注意事项",[1043,1196,1197,1200,1203],{},[1046,1198,1199],{},"系统会显示警告信息，这是正常的",[1046,1201,1202],{},"重启后分别检查 Windows 和 Ubuntu 时间是否一致",[1046,1204,1205],{},"警告不影响功能，可以忽略",[1011,1207,1209],{"id":1208},"ssh-双系统冲突修改-ubuntu-ssh-端口号","SSH 双系统冲突：修改 Ubuntu SSH 端口号",[1015,1211,1212],{},"由于我现在使用网线进行网络连接，Windows 和 Ubuntu 共用一个 IP 地址，导致 SSH fingerprint 变更，在 SSH 连接的时候就会有麻烦出现，所以这里就把 Ubuntu 的端口号进行更改，流程如下。",[1039,1214,1216],{"id":1215},"ubuntu-2404","Ubuntu 24.04",[1015,1218,1219],{},"Ubuntu 24.04 比较特殊，请参见以下文章：",[1043,1221,1222],{},[1046,1223,1224],{},[1049,1225,1228],{"href":1226,"rel":1227},"https:\u002F\u002Fwww.cnblogs.com\u002Fxiao987334176\u002Fp\u002F18806530",[1053],"Ubuntu 24.04.2 修改 ssh 端口 - 博客园",[1039,1230,1232],{"id":1231},"其他版本的-ubuntu","其他版本的 Ubuntu",[1015,1234,1235],{},"修改 Ubuntu SSH 端口到 2222：",[1139,1237,1238,1249,1260,1271,1282],{},[1046,1239,1240,1243],{},[1118,1241,1242],{},"编辑 SSH 配置",[1019,1244,1247],{"className":1245,"code":1246,"language":1024,"meta":1025},[1022],"sudo nano \u002Fetc\u002Fssh\u002Fsshd_config\n",[1027,1248,1246],{"__ignoreMap":1025},[1046,1250,1251,1254],{},[1118,1252,1253],{},"修改端口行",[1019,1255,1258],{"className":1256,"code":1257,"language":1024,"meta":1025},[1022],"Port 2222\n",[1027,1259,1257],{"__ignoreMap":1025},[1046,1261,1262,1265],{},[1118,1263,1264],{},"重启 SSH 服务",[1019,1266,1269],{"className":1267,"code":1268,"language":1024,"meta":1025},[1022],"sudo systemctl restart sshd\n",[1027,1270,1268],{"__ignoreMap":1025},[1046,1272,1273,1276],{},[1118,1274,1275],{},"更新防火墙",[1019,1277,1280],{"className":1278,"code":1279,"language":1024,"meta":1025},[1022],"sudo ufw allow 2222\u002Ftcp\nsudo ufw delete allow 22\u002Ftcp\n",[1027,1281,1279],{"__ignoreMap":1025},[1046,1283,1284,1287],{},[1118,1285,1286],{},"连接测试",[1019,1288,1291],{"className":1289,"code":1290,"language":1024,"meta":1025},[1022],"ssh -p 2222 username@10.112.100.172\n",[1027,1292,1290],{"__ignoreMap":1025},[1039,1294,1296],{"id":1295},"在-vscode-中修改配置","在 VSCode 中修改配置",[1019,1298,1303],{"className":1299,"code":1301,"language":1302,"meta":1025},[1300],"language-Plain","Host soleilUbuntu\n  HostName 10.112.100.172\n  User soleil\n  Port 2222\n","Plain",[1027,1304,1301],{"__ignoreMap":1025},[1011,1306,1308],{"id":1307},"屏幕亮度调节显示屏","屏幕亮度调节（显示屏）",[1015,1310,1311,1312,1317],{},"使用 GNOME Shell 扩展 ",[1049,1313,1316],{"href":1314,"rel":1315},"https:\u002F\u002Fextensions.gnome.org\u002Fextension\u002F5943\u002Fsoft-brightness-plus\u002F",[1053],"Soft Brightness Plus"," 来调节亮度，安装步骤如下。",[1039,1319,1320],{"id":1320},"安装步骤",[1322,1323,1325],"h4",{"id":1324},"_1-先安装浏览器扩展","1. 先安装浏览器扩展",[1015,1327,1328,1329,1332],{},"点击页面顶部蓝色提示框中的 ",[1118,1330,1331],{},"\"Click here to install browser extension\""," 链接，安装浏览器集成插件。",[1322,1334,1336],{"id":1335},"_2-安装本地连接器native-host-connector","2. 安装本地连接器（Native Host Connector）",[1015,1338,1339],{},"根据你的 Linux 发行版，安装本地主机消息应用：",[1015,1341,1342],{},[1118,1343,1344],{},"Ubuntu\u002FDebian:",[1019,1346,1349],{"className":1347,"code":1348,"language":1024,"meta":1025},[1022],"sudo apt install chrome-gnome-shell\n",[1027,1350,1348],{"__ignoreMap":1025},[1322,1352,1354],{"id":1353},"_3-查看你的-gnome-shell-版本","3. 查看你的 GNOME Shell 版本",[1015,1356,1357],{},"在终端运行：",[1019,1359,1362],{"className":1360,"code":1361,"language":1024,"meta":1025},[1022],"gnome-shell --version\n",[1027,1363,1361],{"__ignoreMap":1025},[1322,1365,1367],{"id":1366},"_4-选择对应版本并安装","4. 选择对应版本并安装",[1043,1369,1370,1377,1380,1387],{},[1046,1371,1372,1373,1376],{},"点击页面上的 ",[1118,1374,1375],{},"\"Shell version...\""," 下拉菜单",[1046,1378,1379],{},"选择与你的 GNOME Shell 版本匹配的版本",[1046,1381,1382,1383,1386],{},"点击蓝色的 ",[1118,1384,1385],{},"\"Install\""," 按钮",[1046,1388,1389],{},"在弹出的对话框中确认安装",[1322,1391,1393],{"id":1392},"_5-管理扩展","5. 管理扩展",[1015,1395,1396],{},"安装完成后，你可以通过以下方式管理扩展：",[1043,1398,1399,1406],{},[1046,1400,1401,1402,1405],{},"访问网站顶部的 ",[1118,1403,1404],{},"\"Installed extensions\""," 页面",[1046,1407,1408],{},"或使用 GNOME Extensions 应用（如果已安装）",[1015,1410,1411],{},"完成这些步骤后，Soft Brightness 扩展就应该可以正常工作了！",[1039,1413,1041],{"id":1414},"参考资料-2",[1043,1416,1417],{},[1046,1418,1419],{},[1049,1420,1422],{"href":1314,"rel":1421},[1053],"Soft Brightness Plus - GNOME Shell Extensions",{"title":1025,"searchDepth":1424,"depth":1424,"links":1425},4,[1426,1431,1437,1443,1448],{"id":1013,"depth":1427,"text":1013,"children":1428},2,[1429],{"id":1041,"depth":1430,"text":1041},3,{"id":1057,"depth":1427,"text":1057,"children":1432},[1433,1434,1435,1436],{"id":1060,"depth":1430,"text":1060},{"id":1069,"depth":1430,"text":1070},{"id":1079,"depth":1430,"text":1080},{"id":1089,"depth":1430,"text":1041},{"id":1108,"depth":1427,"text":1109,"children":1438},[1439,1440,1441,1442],{"id":1112,"depth":1430,"text":1112},{"id":1136,"depth":1430,"text":1137},{"id":1179,"depth":1430,"text":1179},{"id":1194,"depth":1430,"text":1194},{"id":1208,"depth":1427,"text":1209,"children":1444},[1445,1446,1447],{"id":1215,"depth":1430,"text":1216},{"id":1231,"depth":1430,"text":1232},{"id":1295,"depth":1430,"text":1296},{"id":1307,"depth":1427,"text":1308,"children":1449},[1450,1457],{"id":1320,"depth":1430,"text":1320,"children":1451},[1452,1453,1454,1455,1456],{"id":1324,"depth":1424,"text":1325},{"id":1335,"depth":1424,"text":1336},{"id":1353,"depth":1424,"text":1354},{"id":1366,"depth":1424,"text":1367},{"id":1392,"depth":1424,"text":1393},{"id":1414,"depth":1430,"text":1041},[1126],"装好系统之后的各种配置","md",null,{"slots":1463},{},{"text":158,"minutes":944,"time":945,"words":946},{"title":941,"description":1459},{"loc":940},[],"tech","2025-12-19 19:38:06","LUaFqXtnKjsY_ggFluTfKaSDogxO4NopgqCu_W7lmeY",[1472,1473],{"title":999,"path":998,"stem":997,"date":1000,"type":1468,"children":-1},{"title":967,"path":966,"stem":965,"date":951,"type":1468,"children":-1},1792852082869]