验证安装\nstarship --version\n\necho 'eval \"$(starship init zsh)\"' >> ~\u002F.zshrc\nsource ~\u002F.zshrc\n",[994,1053,1051],{"__ignoreMap":992},[1006,1055,1008],{"id":1056},"参考资料-1",[1010,1058,1059,1066],{},[1013,1060,1061],{},[1016,1062,1065],{"href":1063,"rel":1064},"https:\u002F\u002Fsorrycc.com\u002Fmac",[1020],"sorrycc 的 Mac 配置",[1013,1067,1068],{},[1016,1069,1072],{"href":1070,"rel":1071},"https:\u002F\u002Fwww.haoyep.com\u002Fposts\u002Fzsh-config-oh-my-zsh\u002F",[1020],"zsh 安装与配置，使用 oh-my-zsh 美化终端",[978,1074,1076],{"id":1075},"ubuntuwindows-双启动时间冲突","Ubuntu\u002FWindows 双启动时间冲突",[1006,1078,1079],{"id":1079},"问题原因",[1010,1081,1082,1089,1095],{},[1013,1083,1084,1088],{},[1085,1086,1087],"strong",{},"Windows","：硬件时钟存储本地时间",[1013,1090,1091,1094],{},[1085,1092,1093],{},"Ubuntu","：硬件时钟存储 UTC 时间",[1013,1096,1097,1100],{},[1085,1098,1099],{},"结果","：切换系统时出现 8 小时时差",[1006,1102,1104],{"id":1103},"ubuntu-2204-及以下解决方案","Ubuntu 22.04 及以下解决方案",[1106,1107,1108,1117,1126,1135],"ol",{},[1013,1109,1110,1111],{},"安装时间同步工具",[986,1112,1115],{"className":1113,"code":1114,"language":991,"meta":992},[989],"sudo apt install ntpdate\n",[994,1116,1114],{"__ignoreMap":992},[1013,1118,1119,1120],{},"同步时间",[986,1121,1124],{"className":1122,"code":1123,"language":991,"meta":992},[989],"sudo ntpdate time.windows.com\n",[994,1125,1123],{"__ignoreMap":992},[1013,1127,1128,1129],{},"设置硬件时钟为本地时间",[986,1130,1133],{"className":1131,"code":1132,"language":991,"meta":992},[989],"sudo hwclock --localtime --systohc\n",[994,1134,1132],{"__ignoreMap":992},[1013,1136,1137,1138],{},"配置系统使用本地时区 RTC",[986,1139,1142],{"className":1140,"code":1141,"language":991,"meta":992},[989],"sudo timedatectl set-local-rtc 1 --adjust-system-clock\n",[994,1143,1141],{"__ignoreMap":992},[1006,1145,1146],{"id":1146},"验证结果",[986,1148,1151],{"className":1149,"code":1150,"language":991,"meta":992},[989],"timedatectl status\n",[994,1152,1150],{"__ignoreMap":992},[982,1154,1155,1156],{},"确认显示：",[994,1157,1158],{"code":1158},"RTC in local TZ: yes",[1006,1160,1161],{"id":1161},"注意事项",[1010,1163,1164,1167,1170],{},[1013,1165,1166],{},"系统会显示警告信息，这是正常的",[1013,1168,1169],{},"重启后分别检查 Windows 和 Ubuntu 时间是否一致",[1013,1171,1172],{},"警告不影响功能，可以忽略",[978,1174,1176],{"id":1175},"ssh-双系统冲突修改-ubuntu-ssh-端口号","SSH 双系统冲突：修改 Ubuntu SSH 端口号",[982,1178,1179],{},"由于我现在使用网线进行网络连接，Windows 和 Ubuntu 共用一个 IP 地址，导致 SSH fingerprint 变更，在 SSH 连接的时候就会有麻烦出现，所以这里就把 Ubuntu 的端口号进行更改，流程如下。",[1006,1181,1183],{"id":1182},"ubuntu-2404","Ubuntu 24.04",[982,1185,1186],{},"Ubuntu 24.04 比较特殊，请参见以下文章：",[1010,1188,1189],{},[1013,1190,1191],{},[1016,1192,1195],{"href":1193,"rel":1194},"https:\u002F\u002Fwww.cnblogs.com\u002Fxiao987334176\u002Fp\u002F18806530",[1020],"Ubuntu 24.04.2 修改 ssh 端口 - 博客园",[1006,1197,1199],{"id":1198},"其他版本的-ubuntu","其他版本的 Ubuntu",[982,1201,1202],{},"修改 Ubuntu SSH 端口到 2222：",[1106,1204,1205,1216,1227,1238,1249],{},[1013,1206,1207,1210],{},[1085,1208,1209],{},"编辑 SSH 配置",[986,1211,1214],{"className":1212,"code":1213,"language":991,"meta":992},[989],"sudo nano \u002Fetc\u002Fssh\u002Fsshd_config\n",[994,1215,1213],{"__ignoreMap":992},[1013,1217,1218,1221],{},[1085,1219,1220],{},"修改端口行",[986,1222,1225],{"className":1223,"code":1224,"language":991,"meta":992},[989],"Port 2222\n",[994,1226,1224],{"__ignoreMap":992},[1013,1228,1229,1232],{},[1085,1230,1231],{},"重启 SSH 服务",[986,1233,1236],{"className":1234,"code":1235,"language":991,"meta":992},[989],"sudo systemctl restart sshd\n",[994,1237,1235],{"__ignoreMap":992},[1013,1239,1240,1243],{},[1085,1241,1242],{},"更新防火墙",[986,1244,1247],{"className":1245,"code":1246,"language":991,"meta":992},[989],"sudo ufw allow 2222\u002Ftcp\nsudo ufw delete allow 22\u002Ftcp\n",[994,1248,1246],{"__ignoreMap":992},[1013,1250,1251,1254],{},[1085,1252,1253],{},"连接测试",[986,1255,1258],{"className":1256,"code":1257,"language":991,"meta":992},[989],"ssh -p 2222 username@10.112.100.172\n",[994,1259,1257],{"__ignoreMap":992},[1006,1261,1263],{"id":1262},"在-vscode-中修改配置","在 VSCode 中修改配置",[986,1265,1270],{"className":1266,"code":1268,"language":1269,"meta":992},[1267],"language-Plain","Host soleilUbuntu\n  HostName 10.112.100.172\n  User soleil\n  Port 2222\n","Plain",[994,1271,1268],{"__ignoreMap":992},[978,1273,1275],{"id":1274},"屏幕亮度调节显示屏","屏幕亮度调节（显示屏）",[982,1277,1278,1279,1284],{},"使用 GNOME Shell 扩展 ",[1016,1280,1283],{"href":1281,"rel":1282},"https:\u002F\u002Fextensions.gnome.org\u002Fextension\u002F5943\u002Fsoft-brightness-plus\u002F",[1020],"Soft Brightness Plus"," 来调节亮度，安装步骤如下。",[1006,1286,1287],{"id":1287},"安装步骤",[1289,1290,1292],"h4",{"id":1291},"_1-先安装浏览器扩展","1. 先安装浏览器扩展",[982,1294,1295,1296,1299],{},"点击页面顶部蓝色提示框中的 ",[1085,1297,1298],{},"\"Click here to install browser extension\""," 链接，安装浏览器集成插件。",[1289,1301,1303],{"id":1302},"_2-安装本地连接器native-host-connector","2. 安装本地连接器（Native Host Connector）",[982,1305,1306],{},"根据你的 Linux 发行版，安装本地主机消息应用：",[982,1308,1309],{},[1085,1310,1311],{},"Ubuntu\u002FDebian:",[986,1313,1316],{"className":1314,"code":1315,"language":991,"meta":992},[989],"sudo apt install chrome-gnome-shell\n",[994,1317,1315],{"__ignoreMap":992},[1289,1319,1321],{"id":1320},"_3-查看你的-gnome-shell-版本","3. 查看你的 GNOME Shell 版本",[982,1323,1324],{},"在终端运行：",[986,1326,1329],{"className":1327,"code":1328,"language":991,"meta":992},[989],"gnome-shell --version\n",[994,1330,1328],{"__ignoreMap":992},[1289,1332,1334],{"id":1333},"_4-选择对应版本并安装","4. 选择对应版本并安装",[1010,1336,1337,1344,1347,1354],{},[1013,1338,1339,1340,1343],{},"点击页面上的 ",[1085,1341,1342],{},"\"Shell version...\""," 下拉菜单",[1013,1345,1346],{},"选择与你的 GNOME Shell 版本匹配的版本",[1013,1348,1349,1350,1353],{},"点击蓝色的 ",[1085,1351,1352],{},"\"Install\""," 按钮",[1013,1355,1356],{},"在弹出的对话框中确认安装",[1289,1358,1360],{"id":1359},"_5-管理扩展","5. 管理扩展",[982,1362,1363],{},"安装完成后，你可以通过以下方式管理扩展：",[1010,1365,1366,1373],{},[1013,1367,1368,1369,1372],{},"访问网站顶部的 ",[1085,1370,1371],{},"\"Installed extensions\""," 页面",[1013,1374,1375],{},"或使用 GNOME Extensions 应用（如果已安装）",[982,1377,1378],{},"完成这些步骤后，Soft Brightness 扩展就应该可以正常工作了！",[1006,1380,1008],{"id":1381},"参考资料-2",[1010,1383,1384],{},[1013,1385,1386],{},[1016,1387,1389],{"href":1281,"rel":1388},[1020],"Soft Brightness Plus - GNOME Shell Extensions",{"title":992,"searchDepth":1391,"depth":1391,"links":1392},4,[1393,1398,1404,1410,1415],{"id":980,"depth":1394,"text":980,"children":1395},2,[1396],{"id":1008,"depth":1397,"text":1008},3,{"id":1024,"depth":1394,"text":1024,"children":1399},[1400,1401,1402,1403],{"id":1027,"depth":1397,"text":1027},{"id":1036,"depth":1397,"text":1037},{"id":1046,"depth":1397,"text":1047},{"id":1056,"depth":1397,"text":1008},{"id":1075,"depth":1394,"text":1076,"children":1405},[1406,1407,1408,1409],{"id":1079,"depth":1397,"text":1079},{"id":1103,"depth":1397,"text":1104},{"id":1146,"depth":1397,"text":1146},{"id":1161,"depth":1397,"text":1161},{"id":1175,"depth":1394,"text":1176,"children":1411},[1412,1413,1414],{"id":1182,"depth":1397,"text":1183},{"id":1198,"depth":1397,"text":1199},{"id":1262,"depth":1397,"text":1263},{"id":1274,"depth":1394,"text":1275,"children":1416},[1417,1424],{"id":1287,"depth":1397,"text":1287,"children":1418},[1419,1420,1421,1422,1423],{"id":1291,"depth":1391,"text":1292},{"id":1302,"depth":1391,"text":1303},{"id":1320,"depth":1391,"text":1321},{"id":1333,"depth":1391,"text":1334},{"id":1359,"depth":1391,"text":1360},{"id":1381,"depth":1397,"text":1008},[1093],"装好系统之后的各种配置","md",null,{"slots":1430},{},{"text":158,"minutes":911,"time":912,"words":913},{"title":908,"description":1426},{"loc":907},[],"tech","2025-12-19 19:38:06","LUaFqXtnKjsY_ggFluTfKaSDogxO4NopgqCu_W7lmeY",[1439,1440],{"title":966,"path":965,"stem":964,"date":967,"type":1435,"children":-1},{"title":934,"path":933,"stem":932,"date":918,"type":1435,"children":-1},1789097770291]