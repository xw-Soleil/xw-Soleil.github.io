e":1131},"border: none;","\n  ",[1012,1134,1136,1132],{"style":1135},"width: 50.0%; text-align: center; border: none; padding: 0.3em; margin: 0;",[978,1137,1138],{},[1139,1140],"img",{"alt":1141,"src":1142},"image.png","https:\u002F\u002Fphenthu-1321233386.cos.ap-nanjing.myqcloud.com\u002Fimg\u002FHDL\u002FLecture6-01.webp",[1012,1144,1145,1132],{"style":1135},[978,1146,1147],{},[1139,1148],{"alt":1141,"src":1149},"https:\u002F\u002Fphenthu-1321233386.cos.ap-nanjing.myqcloud.com\u002Fimg\u002FHDL\u002FLecture6-02.webp",[982,1151,1152],{"id":1152},"过程赋值",[1154,1155,1156],"h3",{"id":1156},"过程阻塞赋值",[978,1158,1159],{},"如果当前赋值没有完成，则顺序块中的下一步执行无法开始。",[1161,1162,1168],"pre",{"className":1163,"code":1165,"language":1166,"meta":1167},[1164],"language-verilog","reg [7:0] a, b, c;\nalways @(c) begin\n    a = c + 2;\n    b = c * 3;\nend\n\u002F\u002F阻塞赋值:a的赋值必须在b赋值开始前完成\n","verilog","",[1169,1170,1165],"code",{"__ignoreMap":1167},[1154,1172,1005],{"id":1005},[978,1174,1175],{},"当前时间步结束时，会对于顺序块进行并行赋值。",[1107,1177,1179],{"id":1178},"当前时间表结束时的含义","‘当前时间表结束时’的含义",[978,1181,1182],{},"模拟器根据事件的特点，处理对于给定时间的所有事件",[1184,1185,1186,1208,1211],"ol",{},[1187,1188,1189,1190],"li",{},"执行以下操作：\n",[1191,1192,1193,1196,1199,1202,1205],"ul",{},[1187,1194,1195],{},"计算所有赋值的右边",[1187,1197,1198],{},"赋值所有过程阻塞赋值的左边",[1187,1200,1201],{},"赋值所有连续赋值的左边",[1187,1203,1204],{},"计算所有原语(如: 门电路)的输入和输出",[1187,1206,1207],{},"对于$display语句进行打印",[1187,1209,1210],{},"赋值所有过程非阻塞赋值的左边",[1187,1212,1213,1214,1299],{},"根据",[1117,1215,1218,1260],{"className":1216},[1217],"katex",[1117,1219,1222],{"className":1220},[1221],"katex-mathml",[1223,1224,1226],"math",{"xmlns":1225},"http:\u002F\u002Fwww.w3.org\u002F1998\u002FMath\u002FMathML",[1227,1228,1229,1255],"semantics",{},[1230,1231,1232,1236,1239,1242,1245,1248,1251],"mrow",{},[1233,1234,1235],"mi",{},"s",[1233,1237,1238],{},"t",[1233,1240,1241],{},"r",[1233,1243,1244],{},"o",[1233,1246,1247],{},"b",[1233,1249,1250],{},"e",[1252,1253,1254],"mtext",{},"、",[1256,1257,1259],"annotation",{"encoding":1258},"application\u002Fx-tex","strobe、",[1117,1261,1265],{"className":1262,"ariaHidden":1264},[1263],"katex-html","true",[1117,1266,1269,1274,1279,1282,1286,1289,1292,1295],{"className":1267},[1268],"base",[1117,1270],{"className":1271,"style":1273},[1272],"strut","height:0.6944em;",[1117,1275,1235],{"className":1276},[1277,1278],"mord","mathnormal",[1117,1280,1238],{"className":1281},[1277,1278],[1117,1283,1241],{"className":1284,"style":1285},[1277,1278],"margin-right:0.0278em;",[1117,1287,1244],{"className":1288},[1277,1278],[1117,1290,1247],{"className":1291},[1277,1278],[1117,1293,1250],{"className":1294},[1277,1278],[1117,1296,1254],{"className":1297},[1277,1298],"cjk_fallback","monitor语句的执行进行打印",[1154,1301,1302],{"id":1302},"赋值语句的执行",[1107,1304,1305],{"id":1305},"例1",[1161,1307,1310],{"className":1308,"code":1309,"language":1166,"meta":1167},[1164],"reg[7:0]a,b;\ninitial b = 0;\ninitial a = 4;\nalways @(a or b)\n    begin\n        a = b + 2;\n        b = a * 3;\n    end\n\u002F\u002Fa = 0 + 2 = 2\n\u002F\u002Fb = 2 * 3 = 6\n",[1169,1311,1309],{"__ignoreMap":1167},[1161,1313,1316],{"className":1314,"code":1315,"language":1166,"meta":1167},[1164],"reg[7:0] a,b;\ninitial b = 0;\ninitial a = 4;\nalways @(a or b)\n    begin\n        a \u003C= b + 2;\n        b \u003C= a * 3;\n    end\n\u002F\u002Fa = 0 + 2 = 2\n\u002F\u002Fb = 4 * 3 = 12\n",[1169,1317,1315],{"__ignoreMap":1167},[1107,1319,1321],{"id":1320},"例2-对于寄存器的赋值","例2  对于寄存器的赋值",[1323,1324,1325],"h6",{"id":1325},"对于寄存器的阻塞赋值",[1161,1327,1330],{"className":1328,"code":1329,"language":1166,"meta":1167},[1164],"module fsm_mod(q1, q0, in, clk);\n    output q1, q0;\n    input clk, in;\n    reg q1, q0;\n    always @(posedge clk) begin\n        q1 = in;\n        q0 = in | q1;\n    end\nendmodule\n",[1169,1331,1329],{"__ignoreMap":1167},[978,1333,1334],{},"上述代码波形图如下：",[978,1336,1337],{},[1139,1338],{"alt":1141,"src":1339},"https:\u002F\u002Fphenthu-1321233386.cos.ap-nanjing.myqcloud.com\u002Fimg\u002FHDL\u002FLecture6-03.webp",[978,1341,1342],{},"对于使用同一个@posedge或者@negedge的时钟的级联信号而言，它相当于组合逻辑",[978,1344,1345],{},[1139,1346],{"alt":1141,"src":1347},"https:\u002F\u002Fphenthu-1321233386.cos.ap-nanjing.myqcloud.com\u002Fimg\u002FHDL\u002FLecture6-04.webp",[1323,1349,1350],{"id":1350},"对于寄存器的非阻塞赋值",[1161,1352,1355],{"className":1353,"code":1354,"language":1166,"meta":1167},[1164],"module fsm_mod(q1, q0, in, clk);\n    output q1, q0;\n    input clk, in;\n    reg q1, q0;\n    always @(posedge clk) begin\n        q1 \u003C= in;\n        q0 \u003C= in | q1;\n    end\nendmodule\n",[1169,1356,1354],{"__ignoreMap":1167},[1358,1359,1360],"blockquote",{},[978,1361,1362],{},"上述代码波形图",[978,1364,1365],{},[1139,1366],{"alt":1141,"src":1367},"https:\u002F\u002Fphenthu-1321233386.cos.ap-nanjing.myqcloud.com\u002Fimg\u002FHDL\u002FLecture6-05.webp",[978,1369,1370],{},"对于使用同一个@posedge或者@negedge的时钟的级联信号而言，需要加1个寄存器",[978,1372,1373],{},[1139,1374],{"alt":1141,"src":1375},"https:\u002F\u002Fphenthu-1321233386.cos.ap-nanjing.myqcloud.com\u002Fimg\u002FHDL\u002FLecture6-06.webp",[1107,1377,1379],{"id":1378},"例3-d触发器flip-flop的非阻塞赋值","例3  D触发器（flip-flop）的非阻塞赋值",[978,1381,1382],{},"在设计与综合阶段，在always块中的非阻塞赋值以行为一致的方式、被用于D触发器建模",[1191,1384,1385,1388,1391],{},[1187,1386,1387],{},"1个寄存器reg变量被用于表示D触发器",[1187,1389,1390],{},"写入变量(见上例，如：q1或者q0, 使用\u003C=)意味着连接到其D触发器输入",[1187,1392,1393],{},"从变量读取(见上例，如：q1)意味着连接到其D触发器输出",[1161,1395,1398],{"className":1396,"code":1397,"language":1166,"meta":1167},[1164],"always @(posedge iClock) begin : lLoop \u002F\u002FTestbench\n    if (!rReady) disable lLoop;\n    rData = rTData[nDataIndex][`DataMSB:`DataLSB];\nend\n\nalways @(posedge iClock or negedge iReset) begin \u002F\u002FDesign\n    if (!iReset) rDataUse \u003C= 0;\n    else\n        if (iReset) begin\n        rDataUse \u003C= rData;\n    end\nend\n",[1169,1399,1397],{"__ignoreMap":1167},[1401,1402,1404],"h5",{"id":1403},"_3个寄存器链常规","3个寄存器链（常规）",[1161,1406,1409],{"className":1407,"code":1408,"language":1166,"meta":1167},[1164],"module chain(q, i, clk);\n    output q;\n    input i, clk;\nreg q, q1, q2;\nalways @(posedge clk) begin\n    q \u003C= q1;         \u002F\u002F并行所以无关次序\n    q1 \u003C= q2;\n    q2 \u003C= i;\nend\nendmodule\n",[1169,1410,1408],{"__ignoreMap":1167},[1401,1412,1414],{"id":1413},"多路复用的数据通路方法时序存储组合计算","多路复用的数据通路方法(时序存储+组合计算)",[1161,1416,1419],{"className":1417,"code":1418,"language":1166,"meta":1167},[1164],"module chain(q, i, clk); \n    output q; \n    input i, clk; \n    reg q, q1, q2; \n    wire q_next, q1_next, q2_next; \n    always @(posedge clk) begin \n    q \u003C= q_next; \n    q1 \u003C= q1_next; \n    q2 \u003C= q2_next; \n    end \n    assign q_next = q1; \n    assign q1_next = q2; \n    assign q2_next = i; \nendmodule\n\u002F\u002Fq、q1、q2相当于不同的数据通路\n",[1169,1420,1418],{"__ignoreMap":1167},[1401,1422,1423],{"id":1423},"结构化方法",[1161,1425,1428],{"className":1426,"code":1427,"language":1166,"meta":1167},[1164],"module flipflop(q, i, clk);\n    output q;\n    input i, clk;\n    \u002F\u002F implementation of flipflop ..\nendmodule\n\nmodule chain(q, i, clk);\n    output q;\n    input i, clk;\n    wire q1, q2;\n    flipflop F1(q, q1, clk);\n    flipflop F2(q1, q2, clk);\n    flipflop F3(q2, i, clk);\nendmodule\n",[1169,1429,1427],{"__ignoreMap":1167},[982,1431,1432],{"id":1432},"总结",[1191,1434,1435,1438,1441,1444],{},[1187,1436,1437],{},"通常用于在always块中对D触发器类型建模",[1187,1439,1440],{},"模拟多个并发表达式的行为",[1187,1442,1443],{},"可以使用always块中的非阻塞赋值设计诸如: 控制器、数据通路等中的时序逻辑",[1187,1445,1446],{},"通常，不要在同一块中混合非阻塞和阻塞赋值",{"title":1167,"searchDepth":1448,"depth":1448,"links":1449},4,[1450,1454,1471],{"id":984,"depth":1451,"text":984,"children":1452},2,[1453],{"id":1109,"depth":1448,"text":1109},{"id":1152,"depth":1451,"text":1152,"children":1455},[1456,1458,1461],{"id":1156,"depth":1457,"text":1156},3,{"id":1005,"depth":1457,"text":1005,"children":1459},[1460],{"id":1178,"depth":1448,"text":1179},{"id":1302,"depth":1457,"text":1302,"children":1462},[1463,1464,1465],{"id":1305,"depth":1448,"text":1305},{"id":1320,"depth":1448,"text":1321},{"id":1378,"depth":1448,"text":1379,"children":1466},[1467,1469,1470],{"id":1403,"depth":1468,"text":1404},5,{"id":1413,"depth":1468,"text":1414},{"id":1423,"depth":1468,"text":1423},{"id":1432,"depth":1451,"text":1432},[903],"行为级建模中的非阻塞赋值，阻塞与非阻塞赋值的区别","md",null,{"slots":1477},{},{"text":97,"minutes":593,"time":594,"words":595},{"title":590,"description":1473},{"loc":589,"images":1481},[1482,1483,1484,1485,1486,1487],{"loc":1142},{"loc":1149},{"loc":1339},{"loc":1347},{"loc":1367},{"loc":1375},[1489,1490,1491,1492],"非阻塞赋值","行为级建模","HDL","课程笔记","tech","UbdALtNeiEe9Y4uZeUCctkpEUApuKIDlrYwQSaAX26M",[1496,1497],{"title":608,"path":607,"stem":606,"date":544,"type":1493,"children":-1},{"title":581,"path":580,"stem":579,"date":582,"type":1493,"children":-1},1789097777419]