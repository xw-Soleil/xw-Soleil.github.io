5,1085,1086,1087,1089,1090,1092],{},"reg a;",[1078,1088],{},"reg b;",[1078,1091],{},"always @(b)",[1045,1094,1086,1095,1089,1097,1092],{},[1078,1096],{},[1078,1098],{},[1025,1100,1101,1104,1107,1110],{},[1045,1102,1103],{},"左边LHS",[1045,1105,1106],{},"wire",[1045,1108,1109],{},"reg",[1045,1111,1109],{},[1025,1113,1114,1117,1120,1122],{},[1045,1115,1116],{},"右边RHS",[1045,1118,1119],{},"net或reg",[1045,1121,1119],{},[1045,1123,1124],{},"net或reg的表达式",[1025,1126,1127,1130,1133,1136],{},[1045,1128,1129],{},"计算",[1045,1131,1132],{},"当右边的任何地方改变时",[1045,1134,1135],{},"过程化执行",[1045,1137,1138],{},"当前时间步结束时",[1140,1141,1142],"h4",{"id":1142},"过程化执行定义",[1011,1144,1145],{},[1146,1147,1148,1149,1153],"strong",{},"always块被其敏感表中的事件",[1150,1151,1152],"span",{},"包括信号变化","触发，然后开始执行。",[1011,1155,1156],{},"当always块执行时，它的begin-end以顺序方式遍历所有语句代码，直到它运行到一个时间控制语句(@, wait, #)",[1019,1158,1160],{"style":1159},"width: 100%; border: 0; border-collapse: collapse; border-spacing: 0;",[1040,1161,1162],{},[1025,1163,1165,1166,1165,1176],{"style":1164},"border: none;","\n  ",[1045,1167,1169,1165],{"style":1168},"width: 50.0%; text-align: center; border: none; padding: 0.3em; margin: 0;",[1011,1170,1171],{},[1172,1173],"img",{"alt":1174,"src":1175},"image.png","https:\u002F\u002Fphenthu-1321233386.cos.ap-nanjing.myqcloud.com\u002Fimg\u002FHDL\u002FLecture6-01.webp",[1045,1177,1178,1165],{"style":1168},[1011,1179,1180],{},[1172,1181],{"alt":1174,"src":1182},"https:\u002F\u002Fphenthu-1321233386.cos.ap-nanjing.myqcloud.com\u002Fimg\u002FHDL\u002FLecture6-02.webp",[1015,1184,1185],{"id":1185},"过程赋值",[1187,1188,1189],"h3",{"id":1189},"过程阻塞赋值",[1011,1191,1192],{},"如果当前赋值没有完成，则顺序块中的下一步执行无法开始。",[1194,1195,1201],"pre",{"className":1196,"code":1198,"language":1199,"meta":1200},[1197],"language-verilog","reg [7:0] a, b, c;\nalways @(c) begin\n    a = c + 2;\n    b = c * 3;\nend\n\u002F\u002F阻塞赋值:a的赋值必须在b赋值开始前完成\n","verilog","",[1202,1203,1198],"code",{"__ignoreMap":1200},[1187,1205,1038],{"id":1038},[1011,1207,1208],{},"当前时间步结束时，会对于顺序块进行并行赋值。",[1140,1210,1212],{"id":1211},"当前时间表结束时的含义","‘当前时间表结束时’的含义",[1011,1214,1215],{},"模拟器根据事件的特点，处理对于给定时间的所有事件",[1217,1218,1219,1241,1244],"ol",{},[1220,1221,1222,1223],"li",{},"执行以下操作：\n",[1224,1225,1226,1229,1232,1235,1238],"ul",{},[1220,1227,1228],{},"计算所有赋值的右边",[1220,1230,1231],{},"赋值所有过程阻塞赋值的左边",[1220,1233,1234],{},"赋值所有连续赋值的左边",[1220,1236,1237],{},"计算所有原语(如: 门电路)的输入和输出",[1220,1239,1240],{},"对于$display语句进行打印",[1220,1242,1243],{},"赋值所有过程非阻塞赋值的左边",[1220,1245,1246,1247,1332],{},"根据",[1150,1248,1251,1293],{"className":1249},[1250],"katex",[1150,1252,1255],{"className":1253},[1254],"katex-mathml",[1256,1257,1259],"math",{"xmlns":1258},"http:\u002F\u002Fwww.w3.org\u002F1998\u002FMath\u002FMathML",[1260,1261,1262,1288],"semantics",{},[1263,1264,1265,1269,1272,1275,1278,1281,1284],"mrow",{},[1266,1267,1268],"mi",{},"s",[1266,1270,1271],{},"t",[1266,1273,1274],{},"r",[1266,1276,1277],{},"o",[1266,1279,1280],{},"b",[1266,1282,1283],{},"e",[1285,1286,1287],"mtext",{},"、",[1289,1290,1292],"annotation",{"encoding":1291},"application\u002Fx-tex","strobe、",[1150,1294,1298],{"className":1295,"ariaHidden":1297},[1296],"katex-html","true",[1150,1299,1302,1307,1312,1315,1319,1322,1325,1328],{"className":1300},[1301],"base",[1150,1303],{"className":1304,"style":1306},[1305],"strut","height:0.6944em;",[1150,1308,1268],{"className":1309},[1310,1311],"mord","mathnormal",[1150,1313,1271],{"className":1314},[1310,1311],[1150,1316,1274],{"className":1317,"style":1318},[1310,1311],"margin-right:0.0278em;",[1150,1320,1277],{"className":1321},[1310,1311],[1150,1323,1280],{"className":1324},[1310,1311],[1150,1326,1283],{"className":1327},[1310,1311],[1150,1329,1287],{"className":1330},[1310,1331],"cjk_fallback","monitor语句的执行进行打印",[1187,1334,1335],{"id":1335},"赋值语句的执行",[1140,1337,1338],{"id":1338},"例1",[1194,1340,1343],{"className":1341,"code":1342,"language":1199,"meta":1200},[1197],"reg[7:0]a,b;\ninitial b = 0;\ninitial a = 4;\nalways @(a or b)\n    begin\n        a = b + 2;\n        b = a * 3;\n    end\n\u002F\u002Fa = 0 + 2 = 2\n\u002F\u002Fb = 2 * 3 = 6\n",[1202,1344,1342],{"__ignoreMap":1200},[1194,1346,1349],{"className":1347,"code":1348,"language":1199,"meta":1200},[1197],"reg[7:0] a,b;\ninitial b = 0;\ninitial a = 4;\nalways @(a or b)\n    begin\n        a \u003C= b + 2;\n        b \u003C= a * 3;\n    end\n\u002F\u002Fa = 0 + 2 = 2\n\u002F\u002Fb = 4 * 3 = 12\n",[1202,1350,1348],{"__ignoreMap":1200},[1140,1352,1354],{"id":1353},"例2-对于寄存器的赋值","例2  对于寄存器的赋值",[1356,1357,1358],"h6",{"id":1358},"对于寄存器的阻塞赋值",[1194,1360,1363],{"className":1361,"code":1362,"language":1199,"meta":1200},[1197],"module fsm_mod(q1, q0, in, clk);\n    output q1, q0;\n    input clk, in;\n    reg q1, q0;\n    always @(posedge clk) begin\n        q1 = in;\n        q0 = in | q1;\n    end\nendmodule\n",[1202,1364,1362],{"__ignoreMap":1200},[1011,1366,1367],{},"上述代码波形图如下：",[1011,1369,1370],{},[1172,1371],{"alt":1174,"src":1372},"https:\u002F\u002Fphenthu-1321233386.cos.ap-nanjing.myqcloud.com\u002Fimg\u002FHDL\u002FLecture6-03.webp",[1011,1374,1375],{},"对于使用同一个@posedge或者@negedge的时钟的级联信号而言，它相当于组合逻辑",[1011,1377,1378],{},[1172,1379],{"alt":1174,"src":1380},"https:\u002F\u002Fphenthu-1321233386.cos.ap-nanjing.myqcloud.com\u002Fimg\u002FHDL\u002FLecture6-04.webp",[1356,1382,1383],{"id":1383},"对于寄存器的非阻塞赋值",[1194,1385,1388],{"className":1386,"code":1387,"language":1199,"meta":1200},[1197],"module fsm_mod(q1, q0, in, clk);\n    output q1, q0;\n    input clk, in;\n    reg q1, q0;\n    always @(posedge clk) begin\n        q1 \u003C= in;\n        q0 \u003C= in | q1;\n    end\nendmodule\n",[1202,1389,1387],{"__ignoreMap":1200},[1391,1392,1393],"blockquote",{},[1011,1394,1395],{},"上述代码波形图",[1011,1397,1398],{},[1172,1399],{"alt":1174,"src":1400},"https:\u002F\u002Fphenthu-1321233386.cos.ap-nanjing.myqcloud.com\u002Fimg\u002FHDL\u002FLecture6-05.webp",[1011,1402,1403],{},"对于使用同一个@posedge或者@negedge的时钟的级联信号而言，需要加1个寄存器",[1011,1405,1406],{},[1172,1407],{"alt":1174,"src":1408},"https:\u002F\u002Fphenthu-1321233386.cos.ap-nanjing.myqcloud.com\u002Fimg\u002FHDL\u002FLecture6-06.webp",[1140,1410,1412],{"id":1411},"例3-d触发器flip-flop的非阻塞赋值","例3  D触发器（flip-flop）的非阻塞赋值",[1011,1414,1415],{},"在设计与综合阶段，在always块中的非阻塞赋值以行为一致的方式、被用于D触发器建模",[1224,1417,1418,1421,1424],{},[1220,1419,1420],{},"1个寄存器reg变量被用于表示D触发器",[1220,1422,1423],{},"写入变量(见上例，如：q1或者q0, 使用\u003C=)意味着连接到其D触发器输入",[1220,1425,1426],{},"从变量读取(见上例，如：q1)意味着连接到其D触发器输出",[1194,1428,1431],{"className":1429,"code":1430,"language":1199,"meta":1200},[1197],"always @(posedge iClock) begin : lLoop \u002F\u002FTestbench\n    if (!rReady) disable lLoop;\n    rData = rTData[nDataIndex][`DataMSB:`DataLSB];\nend\n\nalways @(posedge iClock or negedge iReset) begin \u002F\u002FDesign\n    if (!iReset) rDataUse \u003C= 0;\n    else\n        if (iReset) begin\n        rDataUse \u003C= rData;\n    end\nend\n",[1202,1432,1430],{"__ignoreMap":1200},[1434,1435,1437],"h5",{"id":1436},"_3个寄存器链常规","3个寄存器链（常规）",[1194,1439,1442],{"className":1440,"code":1441,"language":1199,"meta":1200},[1197],"module chain(q, i, clk);\n    output q;\n    input i, clk;\nreg q, q1, q2;\nalways @(posedge clk) begin\n    q \u003C= q1;         \u002F\u002F并行所以无关次序\n    q1 \u003C= q2;\n    q2 \u003C= i;\nend\nendmodule\n",[1202,1443,1441],{"__ignoreMap":1200},[1434,1445,1447],{"id":1446},"多路复用的数据通路方法时序存储组合计算","多路复用的数据通路方法(时序存储+组合计算)",[1194,1449,1452],{"className":1450,"code":1451,"language":1199,"meta":1200},[1197],"module chain(q, i, clk); \n    output q; \n    input i, clk; \n    reg q, q1, q2; \n    wire q_next, q1_next, q2_next; \n    always @(posedge clk) begin \n    q \u003C= q_next; \n    q1 \u003C= q1_next; \n    q2 \u003C= q2_next; \n    end \n    assign q_next = q1; \n    assign q1_next = q2; \n    assign q2_next = i; \nendmodule\n\u002F\u002Fq、q1、q2相当于不同的数据通路\n",[1202,1453,1451],{"__ignoreMap":1200},[1434,1455,1456],{"id":1456},"结构化方法",[1194,1458,1461],{"className":1459,"code":1460,"language":1199,"meta":1200},[1197],"module flipflop(q, i, clk);\n    output q;\n    input i, clk;\n    \u002F\u002F implementation of flipflop ..\nendmodule\n\nmodule chain(q, i, clk);\n    output q;\n    input i, clk;\n    wire q1, q2;\n    flipflop F1(q, q1, clk);\n    flipflop F2(q1, q2, clk);\n    flipflop F3(q2, i, clk);\nendmodule\n",[1202,1462,1460],{"__ignoreMap":1200},[1015,1464,1465],{"id":1465},"总结",[1224,1467,1468,1471,1474,1477],{},[1220,1469,1470],{},"通常用于在always块中对D触发器类型建模",[1220,1472,1473],{},"模拟多个并发表达式的行为",[1220,1475,1476],{},"可以使用always块中的非阻塞赋值设计诸如: 控制器、数据通路等中的时序逻辑",[1220,1478,1479],{},"通常，不要在同一块中混合非阻塞和阻塞赋值",{"title":1200,"searchDepth":1481,"depth":1481,"links":1482},4,[1483,1487,1504],{"id":1017,"depth":1484,"text":1017,"children":1485},2,[1486],{"id":1142,"depth":1481,"text":1142},{"id":1185,"depth":1484,"text":1185,"children":1488},[1489,1491,1494],{"id":1189,"depth":1490,"text":1189},3,{"id":1038,"depth":1490,"text":1038,"children":1492},[1493],{"id":1211,"depth":1481,"text":1212},{"id":1335,"depth":1490,"text":1335,"children":1495},[1496,1497,1498],{"id":1338,"depth":1481,"text":1338},{"id":1353,"depth":1481,"text":1354},{"id":1411,"depth":1481,"text":1412,"children":1499},[1500,1502,1503],{"id":1436,"depth":1501,"text":1437},5,{"id":1446,"depth":1501,"text":1447},{"id":1456,"depth":1501,"text":1456},{"id":1465,"depth":1484,"text":1465},[936],"行为级建模中的非阻塞赋值，阻塞与非阻塞赋值的区别","md",null,{"slots":1510},{},{"text":97,"minutes":605,"time":606,"words":607},{"title":602,"description":1506},{"loc":601,"images":1514},[1515,1516,1517,1518,1519,1520],{"loc":1175},{"loc":1182},{"loc":1372},{"loc":1380},{"loc":1400},{"loc":1408},[1522,1523,1524,1525],"非阻塞赋值","行为级建模","HDL","课程笔记","tech","UbdALtNeiEe9Y4uZeUCctkpEUApuKIDlrYwQSaAX26M",[1529,1530],{"title":620,"path":619,"stem":618,"date":556,"type":1526,"children":-1},{"title":593,"path":592,"stem":591,"date":594,"type":1526,"children":-1},1792852087343]